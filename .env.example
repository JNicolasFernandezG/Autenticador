# ============================================================================
# Plantilla Única de Variables de Entorno (.env.example)
# Copiar como `.env` en la raíz del proyecto Autenticador
# ============================================================================

PORT=8086

# Base de datos MongoDB (Local por defecto; en Docker Compose se sobreescribe)
MONGODB_URL=mongodb://localhost:27017
MONGO_USER=tu_usuario_mongo
MONGO_PASSWORD=tu_password_mongo_seguro
DATABASE_NAME=autenticador_db

# Secreto criptográfico para firmar los JWT
JWT_SECRET=tu_secreto_jwt_largo_y_aleatorio

# URLs de los servicios para generación de Magic Links y CORS
FRONTEND_URL=https://autenticacion.asistodo.com.ar
MAYORES_FRONTEND_URL=https://mayoresactualizaciones.asistodo.com.ar
COGNIJUEGOS_FRONTEND_URL=https://cognijuegos.asistodo.com.ar

# Administrador Central Maestro
ADMIN_EMAIL=admin@autenticador.com
ADMIN_PASSWORD=tu_clave_administrador_segura
ADMIN_PIN=123456
ADMIN_NAME=Administrador Central
