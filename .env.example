# ============================================================================
# Plantilla de Variables de Entorno (.env.example)
# Copiar como `.env` en el servidor Linux y completar con claves propias
# ============================================================================

PORT=8086

# Credenciales internas del contenedor MongoDB (definilas vos al crear el .env)
MONGO_USER=tu_usuario_mongo
MONGO_PASSWORD=tu_password_mongo_seguro
DATABASE_NAME=autenticador_db

# Secreto criptográfico para firmar los JWT
JWT_SECRET=tu_secreto_jwt_largo_y_aleatorio

# URLs de los servicios para generación de Magic Links
FRONTEND_URL=https://autenticacion.asistodo.com.ar
MAYORES_FRONTEND_URL=https://mayoresactualizaciones.asistodo.com.ar
CONMIJUEGOS_FRONTEND_URL=https://cognijuegos.asistodo.com.ar
